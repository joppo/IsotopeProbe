@page
@model IndexModel
@{ ViewData["Title"] = "Scan executions"; }
<h1>Scan executions</h1>
<p>@Model.Scans.TotalCount saved execution(s). Newest first.</p>
@if (Model.Scans.TotalCount == 0) { <p>No scans saved yet. Run a scan through the CLI, then reload this page.</p> }
else if (Model.Scans.Items.Count == 0) { <p>No executions on this page. <a asp-page="/Index">Return to the first page</a>.</p> }
else {
<div class="table-scroll"><table>
<thead><tr><th>ID</th><th>Target URL</th><th>Started (UTC)</th><th>Persisted status</th><th>Findings</th></tr></thead>
<tbody>@foreach (var scan in Model.Scans.Items) {
<tr><td><a asp-page="/Executions/Details" asp-route-id="@scan.Id">@scan.Id</a></td><td>@scan.Target</td><td>@Display.Utc(scan.StartedAt)</td><td><span class="badge @Display.Tone(scan.Status.ToString())">@scan.Status</span></td><td>@scan.FindingCount</td></tr>
}</tbody></table></div>
}
<nav aria-label="Pagination">
@if (Model.Scans.Skip > 0) { <a asp-route-skip="@Math.Max(0, Model.Scans.Skip - 20)">Previous</a> }
@if ((long)Model.Scans.Skip + 20 < Model.Scans.TotalCount) { <a asp-route-skip="@(Model.Scans.Skip + 20)">Next</a> }
</nav>
<p>Running is the last persisted state, not proof that a scanner process is alive.</p>
